{
  "name": "@music-editor/renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent Canvas 2D renderer for music editors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check:public-api": "npm run build && tsc --noEmit -p type-tests/tsconfig.json"
  },
  "dependencies": {
    "@music-editor/core": "0.1.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
